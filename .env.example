# ---------------------------------------------------------------------------
# Koinonia Class — environment example
# Copy the relevant blocks into backend/.env and frontend/.env
# ---------------------------------------------------------------------------

# ============================ BACKEND (backend/.env) =======================
# In dev we use SQLite; in prod switch the Prisma provider to postgresql.
# SQLite (dev default):
DATABASE_URL="file:./dev.db"
# PostgreSQL (prod example):
# DATABASE_URL="postgresql://koinonia:koinonia@localhost:5432/koinonia?schema=public"

# Secret used to sign teacher JWTs. Use a long random string in production.
JWT_SECRET="change-me-in-production-please-use-a-long-random-secret"

# HTTP port the Fastify server listens on.
PORT=3333

# Comma-separated list of allowed CORS origins (frontend URLs).
CORS_ORIGIN="http://localhost:5173"

# Public base URL used to build absolute art image URLs for WhatsApp.
PUBLIC_BASE_URL="http://localhost:3333"

# --- WhatsApp (PARTE 10) ---------------------------------------------------
# Provider: "mock" (dev/test, logs OTP) or "cloud" (WhatsApp Business/Cloud API).
WHATSAPP_PROVIDER="mock"
WHATSAPP_API_URL="https://graph.facebook.com/v20.0"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_OTP_TEMPLATE_NAME=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Comma-separated E.164 numbers allowed to self-register as TEACHER.
TEACHER_WHATSAPP_ALLOWLIST=""

# ============================ FRONTEND (frontend/.env) =====================
# Base URL of the REST API.
VITE_API_URL="http://localhost:3333"

# Base URL of the WebSocket (Socket.IO) server.
VITE_WS_URL="http://localhost:3333"

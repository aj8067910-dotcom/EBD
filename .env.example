# ---------------------------------------------------------------------------
# Koinonia Class — environment example
# Copy the relevant blocks into backend/.env and frontend/.env
# ---------------------------------------------------------------------------

# ============================ BACKEND (backend/.env) =======================
# In dev we use SQLite; in prod switch the Prisma provider to postgresql.
# SQLite (dev default):
DATABASE_URL="file:./dev.db"
# PostgreSQL (prod example):
# DATABASE_URL="postgresql://koinonia:koinonia@localhost:5432/koinonia?schema=public"

# Secret used to sign teacher JWTs. Use a long random string in production.
JWT_SECRET="change-me-in-production-please-use-a-long-random-secret"

# HTTP port the Fastify server listens on.
PORT=3333

# Comma-separated list of allowed CORS origins (frontend URLs).
CORS_ORIGIN="http://localhost:5173"

# Public base URL used to build absolute art image URLs for WhatsApp.
# In production this MUST be an absolute https:// URL (never localhost) — the
# WhatsApp Cloud API fetches the art from here for the daily-reading template.
PUBLIC_BASE_URL="http://localhost:3333"

# --- WhatsApp (PARTE 10) ---------------------------------------------------
# Provider: "mock" (dev/test, logs OTP) or "cloud" (WhatsApp Business/Cloud API).
# When WHATSAPP_PROVIDER=cloud, the following are REQUIRED (startup fails fast
# if any is missing): ACCESS_TOKEN, PHONE_NUMBER_ID, OTP_TEMPLATE_NAME,
# DAILY_READING_TEMPLATE_NAME, APP_SECRET.
WHATSAPP_PROVIDER="mock"
WHATSAPP_API_URL="https://graph.facebook.com/v20.0"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Approved template names (Meta Business Manager). OTP: one body variable ({{1}}
# = code) and a URL button variable. Daily reading: an IMAGE header + one body
# variable ({{1}} = caption text).
WHATSAPP_OTP_TEMPLATE_NAME=""
WHATSAPP_DAILY_READING_TEMPLATE_NAME=""
# BCP-47 template language code (must match the approved template locale).
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Meta App Secret — validates inbound webhook X-Hub-Signature-256 signatures.
WHATSAPP_APP_SECRET=""
# Comma-separated E.164 numbers allowed to self-register as TEACHER.
TEACHER_WHATSAPP_ALLOWLIST=""

# --- Primeiro admin (bootstrap) --------------------------------------------
# Se ADMIN_EMAIL e ADMIN_PASSWORD estiverem definidos, uma conta de professor
# é criada automaticamente no 1º boot (idempotente — não redefine a senha se a
# conta já existir). Ideal para produção (ex.: Render) sem usar a senha demo.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"

# ============================ FRONTEND (frontend/.env) =====================
# Base URL of the REST API.
VITE_API_URL="http://localhost:3333"

# Base URL of the WebSocket (Socket.IO) server.
VITE_WS_URL="http://localhost:3333"

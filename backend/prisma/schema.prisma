// Koinonia Class — Prisma data model.
//
// Provider is SQLite in development. For production, switch `provider` to
// "postgresql" and point DATABASE_URL at the Postgres instance
// (see docker-compose.yml). SQLite does not support native enums, so status /
// phase / type fields are modeled as String and validated in application code
// against the shared Zod schemas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// The Teacher table is the application User entity (PARTE 10). It keeps its name
// to avoid churn on existing relations; `role` distinguishes TEACHER from a
// registered STUDENT (anonymous room participants are a separate concept).
model Teacher {
  id             String    @id @default(cuid())
  name           String
  // Email/password auth stays optional for backward compatibility.
  email          String?   @unique
  passwordHash   String?
  // WhatsApp identity (E.164). Unique across users; the OTP login key.
  whatsappNumber String?   @unique
  role           String    @default("TEACHER") // TEACHER | STUDENT
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt @default(now())
  lastLoginAt    DateTime?

  lessons        Lesson[]
  rooms          Room[]
  dailyReadings  DailyReading[]
  subscription   WhatsAppSubscription?
  whatsappMessages WhatsAppMessage[]

  @@index([role])
}

// One-time password challenges for WhatsApp login (stored hashed, short-lived).
// The challenge also carries the pending state needed to complete the flow so
// nothing lives in process memory (survives restart / multi-instance) — B-04:
//   REGISTER       -> `name` holds the pending self-registration name
//   CHANGE_NUMBER  -> `userId` holds the user changing their number
model OtpCode {
  id             String   @id @default(cuid())
  whatsappNumber String
  codeHash       String
  purpose        String   @default("LOGIN") // LOGIN | REGISTER | CHANGE_NUMBER
  attempts       Int      @default(0)
  consumed       Boolean  @default(false)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  // Pending flow state (see model comment).
  name           String?
  userId         String?

  @@index([whatsappNumber])
  @@index([userId])
  @@index([expiresAt])
}

// A daily reading a teacher can publish and send by WhatsApp.
model DailyReading {
  id          String    @id @default(cuid())
  teacherId   String
  title       String
  verse       String
  reference   String
  message     String?
  readingDate DateTime
  imageUrl    String?
  // DRAFT | PUBLISHED | SENT
  status      String    @default("DRAFT")
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())
  publishedAt DateTime?
  sentAt      DateTime?

  teacher  Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  messages WhatsAppMessage[]

  @@index([teacherId])
  @@index([readingDate])
  @@index([status])
}

// Per-user communication preferences (opt-in/opt-out for daily readings).
model WhatsAppSubscription {
  id                  String   @id @default(cuid())
  userId              String   @unique
  enabled             Boolean  @default(true)
  dailyReadingEnabled Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt @default(now())

  user Teacher @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per (reading, user, type) to record delivery and prevent duplicates.
model WhatsAppMessage {
  id                String   @id @default(cuid())
  userId            String
  dailyReadingId    String?
  type              String   @default("DAILY_READING")
  // PENDING | SENT | FAILED | CANCELLED
  status            String   @default("PENDING")
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime @default(now())

  user         Teacher       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyReading DailyReading? @relation(fields: [dailyReadingId], references: [id], onDelete: Cascade)

  @@unique([dailyReadingId, userId, type])
  @@index([userId])
  @@index([status])
}

model Lesson {
  id             String   @id @default(cuid())
  teacherId      String
  title          String
  bibleReference String
  date           DateTime?
  notes          String?
  // Short random token for the public pre-class (Just-in-Time Teaching) link.
  preClassToken  String   @unique @default(cuid())
  createdAt      DateTime @default(now())

  teacher          Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  moments          Moment[]
  rooms            Room[]
  preClassResponses PreClassResponse[]

  @@index([teacherId])
}

model Moment {
  id               String  @id @default(cuid())
  lessonId         String
  order            Int
  // One of the shared MomentType values (POLL, PEER_INSTRUCTION, ...).
  type             String
  title            String
  // Type-specific configuration as JSON text (validated by shared Zod schemas).
  // Stored as String for SQLite/Postgres portability; parsed in app code.
  config           String
  // For gradable moments (Peer Instruction): JSON array of correct option ids.
  correctOptionIds String?
  points           Int     @default(0)
  isPreClass       Boolean @default(false)

  lesson  Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([lessonId])
}

model Room {
  id              String    @id @default(cuid())
  code            String    @unique
  lessonId        String
  teacherId       String
  // WAITING | LIVE | ENDED
  status          String    @default("WAITING")
  activeMomentId  String?
  // Current MomentPhase of the active moment, if any.
  activePhase     String?
  createdAt       DateTime  @default(now())
  endedAt         DateTime?

  lesson         Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  teacher        Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teams          Team[]
  participants   Participant[]
  answers        Answer[]
  wallQuestions  WallQuestion[]

  @@index([lessonId])
  @@index([teacherId])
}

model Team {
  id     String @id @default(cuid())
  roomId String
  name   String
  color  String
  score  Int    @default(0)

  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participants Participant[]

  @@index([roomId])
}

model Participant {
  id       String   @id @default(cuid())
  roomId   String
  nickname String
  teamId   String?
  socketId String?
  joinedAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  room     Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  team     Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  answers  Answer[]
  wallQuestions WallQuestion[]

  @@unique([roomId, nickname])
  @@index([roomId])
}

model Answer {
  id            String   @id @default(cuid())
  momentId      String
  roomId        String
  participantId String
  // MomentPhase this answer belongs to (OPEN, REOPEN, CLOSED, ...).
  phase         String
  // JSON text payload of the submitted answer (parsed in app code).
  payload       String
  isCorrect     Boolean?
  approved      Boolean  @default(false)
  createdAt     DateTime @default(now())

  moment      Moment      @relation(fields: [momentId], references: [id], onDelete: Cascade)
  room        Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([momentId, participantId, phase])
  @@index([roomId])
  @@index([momentId])
}

model WallQuestion {
  id            String   @id @default(cuid())
  roomId        String
  participantId String?
  text          String
  upvotes       Int      @default(0)
  answered      Boolean  @default(false)
  displayed     Boolean  @default(false)
  createdAt     DateTime @default(now())

  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([roomId])
}

model PreClassResponse {
  id        String   @id @default(cuid())
  lessonId  String
  nickname  String
  momentId  String
  // JSON text payload of the pre-class response (parsed in app code).
  payload   String
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([momentId])
}
